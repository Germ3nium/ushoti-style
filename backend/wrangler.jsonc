// Backend API Worker. Kept as .jsonc so Wrangler finds this file before
// the storefront's ../wrangler.jsonc when run from this folder.
{
	"name": "ushoti-style-worker",
	"main": "worker.js",
	"compatibility_date": "2024-01-01",
	"workers_dev": true,
	// ── D1 Database binding ──────────────────────────────────────
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ushoti-db",
			"database_id": "2502467c-367d-4b77-92c8-b78bd1d2627b"
		}
	],
	// ── Environment Variables (Secrets) ─────────────────────────
	// Do NOT put real values here — set them via:
	//   wrangler secret put PAYSTACK_SECRET_KEY  (sk_test_... to test, sk_live_... for real payments)
	//   wrangler secret put ADMIN_KEY
	//   wrangler secret put RESEND_API_KEY     (order emails are skipped without it)
	//   wrangler secret put ORDER_ALERT_EMAIL  (where new order alerts and buyer replies go)
	//   wrangler secret put RESEND_EFT_TEMPLATE (optional: the Resend template ID for the EFT email, see email-templates/)
	"vars": {
		// Where Paystack sends the customer after paying, or after cancelling.
		// Paystack's webhook goes to https://ushoti-style-worker.sihlek56.workers.dev/api/paystack-webhook
		// (set it on the Paystack dashboard: Settings > API Keys & Webhooks)
		"RETURN_URL": "https://ushotistyle.co.za/success.html",
		"CANCEL_URL": "https://ushotistyle.co.za/cart.html"
	},
	// ── Test copy (staging) ─────────────────────────────────────
	// Its own Worker and its own database, so testing never touches real orders.
	// Deploy:  npx wrangler deploy --env staging
	// Secrets: npx wrangler secret put ADMIN_KEY --env staging   (and PAYSTACK_SECRET_KEY with a TEST key)
	"env": {
		"staging": {
			"name": "ushoti-style-worker-staging",
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "ushoti-db-staging",
					"database_id": "ba6db5f7-1aea-4e82-a234-939c549ea94a"
				}
			],
			"vars": {
				"RETURN_URL": "https://ushoti-style-staging.sihlek56.workers.dev/success.html",
				"CANCEL_URL": "https://ushoti-style-staging.sihlek56.workers.dev/cart.html"
			}
		}
	}
}